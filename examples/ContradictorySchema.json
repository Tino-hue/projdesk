{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reading",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "level": {
      "type": "number",
      "minimum": 10,
      "maximum": 5
    },
    "band": {
      "allOf": [
        { "type": "number", "minimum": 0 },
        { "type": "number", "maximum": -1 }
      ]
    },
    "code": {
      "type": "string",
      "minLength": 5,
      "maxLength": 2
    },
    "status": {
      "type": "string",
      "enum": ["open", "closed"],
      "minLength": 10
    }
  },
  "required": ["id", "level"]
}
