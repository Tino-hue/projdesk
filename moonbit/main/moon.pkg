pkgtype(kind: "foreign_library")

import {
  "moonbitlang/core/debug",
  "moonbitstack/moonmodel",
  "moonbitstack/moonmodel/json",
  "moonbitstack/moonmodel/open",
  "moonbitstack/moonmodel/sql",
  "moonbitstack/moonmodel/sdl",
  "Tino-hue/projdesk-kernel/jsonparse",
}

// wasm-gc + JS string builtins: exported String params/returns map to JS string
// Browser / Node instantiate needs: { builtins: ["js-string"], importedStringConstants: "_" }
options(
  "link": {
    "wasm-gc": {
      "use-js-builtin-string": true,
    },
  },
)
